# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://postgres@localhost:5432/motionquest
REDIS_URL=redis://localhost:6379
# 32-byte keys, base64. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=change-me-change-me-change-me-change-me
PII_ENCRYPTION_KEY=
PII_HASH_PEPPER=
ADMIN_API_KEY=
GOOGLE_CLIENT_ID=
REVENUECAT_WEBHOOK_AUTH=
RAZORPAY_WEBHOOK_SECRET=
# console | msg91
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# console | http
WHATSAPP_PROVIDER=console
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
# Production: run `node dist/db/migrate.js` as a deploy step and set this to false.
MIGRATE_ON_BOOT=true
CORS_ORIGINS=
RATE_LIMIT_PER_MIN=300
PUBLIC_BASE_URL=https://motionquest.app
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=app.motionquest
GRIEVANCE_EMAIL=grievance@motionquest.app
# Razorpay API keys (gym payment links, created outside the app)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
