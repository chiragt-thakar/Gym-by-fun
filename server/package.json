{
  "name": "motionquest-server",
  "version": "0.1.0",
  "private": true,
  "description": "MotionQuest backend: TypeScript Fastify modular monolith (identity, progress, gyms, billing, content, reports).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:prod": "node dist/db/migrate.js",
    "content:validate": "tsx src/modules/content/validate-cli.ts ../content/levels",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bullmq": "^6.7.0",
    "fastify": "^5.12.8",
    "google-auth-library": "^11.3.3",
    "ioredis": "^6.0.0",
    "jose": "^6.2.15",
    "kysely": "^0.29.8",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
